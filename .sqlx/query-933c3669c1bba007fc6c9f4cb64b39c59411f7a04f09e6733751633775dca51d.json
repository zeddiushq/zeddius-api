  "query": "INSERT INTO daily_checkins (user_id, date, closed_at)\n         VALUES ($1, $2, now())\n         ON CONFLICT (user_id, date) DO UPDATE SET\n            closed_at = now(),\n            updated_at = now()\n         RETURNING id, date, tomorrow_focus, closed_at, created_at, updated_at",
